{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mi-portfolio",
  "main": "worker.js",
  "compatibility_date": "2025-08-01",
  "assets": {
    "directory": "./dist",
  },
  "r2_buckets": [
    {
      "binding": "PORTFOLIO_BUCKET",
      "bucket_name": "mi-portfolio",
    },
  ],
}
